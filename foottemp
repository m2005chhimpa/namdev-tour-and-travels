footer {
    margin-top: 5rem;
    /* width: 100%; */
    height: 58rem;
    background-image: url(./images/neemrana.jpg);
    background-size: cover;
    background-position: center;
    opacity: 1.1;
}

.footeroverlay {
    background-color: #121212;
    opacity: .88;
    height: 90%;
    /* border: 2px solid red; */
    display: flex;
    justify-content: center;
    position: relative;
    /* align-items: center; */
    width: 100%;
    /* padding: 2.9rem 5rem; */
}

.texilink{
     height: 40rem;
      width: 30%;
       display: flex;
       border: 2px solid red;
}
.textt{
    color:#fff;
     margin-top:2.4rem;
      padding:0 1.5rem;  
      letter-spacing: 1px; /* Space between letters */
    word-spacing: 2px; /* Space between words */ 
    line-height: 1.5; /* Space between lines */ 
    text-align: justify;
}




.footnav{
    background-color: #121212;
    opacity: .88;
    height: 10%;
    border-top: 1px solid #328ADF;
    display: flex;
    justify-content:center;
    position: relative;
    align-items: center;
    gap:3rem;
    text-decoration: none;
    width: 100%;  
}
.footnav a li{
    color:#d3d3d3;
    font-size: 1.3rem;
}
.gettouch {
    width: 26vw;
    position: relative;
    /* margin-left: 4.1rem; */
    color: #FFF;
    margin-top: 2.88rem;
    height: 34rem;
    /* background-color: #313131; */
}

.gettouch .holder {
    margin-top: 3.1rem;
    margin-left: 1rem;
    gap: 2rem;
    color: var(--white, #FBFBFB);

    /* body text */
    /* font-family: Nunito Sans; */
    font-size: 1rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5rem;
    /* 150% */

}

.gettouch .getsubmit input:hover {
    scale: 1.1;
}

.ttlink h4{
    text-decoration: none;
     color:aliceblue; 
     font-size: 1.2rem;
      /* font-family:Verdana, Geneva, Tahoma, sans-serif; */
       font-weight: 100;
       /* text-decoration: underline; */
     letter-spacing: 1.7px; 
       /* Space between letters */
     word-spacing: 1.2px;
     /* Space between words  */
     line-height: 1.3; /* Space between lines */
}

.taxibox a:hover h4{
    color: #328ADF;
}



.about {
    margin-left: 18rem;
    color: #FFF;
    margin-top: 5rem;
    gap: 1.5rem;
    width: 26rem;
    height: 34rem;

    color: var(--white, #FBFBFB);

    /* body text */
    /* font-family: Nunito Sans; */
    font-size: 1rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5rem;
    /* 150% */
    /* background-color: #328ADF;     */
}

